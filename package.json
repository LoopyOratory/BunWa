{
  "name": "waha-bun",
  "version": "2026.10.0",
  "description": "WhatsApp HTTP API - Bun/Hono Edition with Pro features",
  "type": "module",
  "scripts": {
    "start": "bash scripts/start.sh",
    "dev": "bash scripts/dev.sh",
    "dev:ui": "cd frontend && bun run dev",
    "dev:api": "bun --watch run src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "build:frontend": "bash scripts/build-frontend.sh",
    "test": "bun test --parallel src/",
    "verify:calls": "bun run scripts/call-shim-harness.ts",
    "verify:call-tap": "bun run scripts/call-tap-harness.ts",
    "call:agent": "bun run scripts/call-agent.ts",
    "call:live": "bun run scripts/call-live.ts",
    "call:inbound-live": "bun run scripts/call-inbound-live.ts",
    "call:fish": "bun run scripts/fish-bridge.ts",
    "call:latency": "bun run scripts/call-latency.ts",
    "call:live-latency": "bun run scripts/live-latency.ts",
    "call:audio-device": "bash scripts/pulseaudio-call-device.sh",
    "test:postgres": "bun run scripts/test-postgres.ts",
    "postgres:dev": "bun run scripts/pglite-dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint-fix": "oxlint --fix src/",
    "setup": "bun install && bash scripts/build-frontend.sh",
    "verify:recorder": "bun run scripts/recorder-smoke.ts"
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@hapi/boom": "^9.1.4",
    "@livekit/rtc-node": "^1.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@scalar/hono-api-reference": "^0.11.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "async-lock": "^1.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "hono": "^4.13.13",
    "https-proxy-agent": "^9.1.0",
    "knex": "^3.2.10",
    "mammoth": "1.13.0",
    "onnxruntime-node": "1.30.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^11.2.1",
    "promise-retry": "^2.0.1",
    "qrcode": "^1.5.1",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socks-proxy-agent": "^10.1.0",
    "sqlite-vec": "0.1.9",
    "tsyringe": "^4.8.0",
    "ulid": "^2.3.0",
    "unpdf": "2.2.1",
    "user-agents": "^2.1.91",
    "whatsapp-web.js": "^1.34.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/async-lock": "^1.4.2",
    "@types/bun": "^1.4.4",
    "@types/lodash": "^4.14.194",
    "@types/pg": "^8.20.0",
    "@types/promise-retry": "^1.1.6",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "bun-types": "^1.4.4",
    "oxlint": "^1.13.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
