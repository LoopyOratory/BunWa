# =============================================================================
# BunWa minimal production configuration
#
# Everything in BunWa has a working default, so this file contains only what
# matters for a production deployment. For the full surface (proxies, S3,
# Chatwoot, MCP limits, sending policy, health thresholds and the rest) use
# .env.example, and see vault/08 Ops/Configuration Reference.md for which
# settings are actually consumed.
#
# Usage:
#   cp .env.example.minimal .env
#   then fill in the three REQUIRED values below
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# API key for every programmatic request, sent as the x-api-key header.
# Leave this empty and the API is open to anyone who can reach the port.
WAHA_API_KEY=

# Fail closed. With this set to false, requests without a key are rejected
# instead of accepted, which is the whole point of setting the key above.
WAHA_ALLOW_NO_AUTH=false

# Dashboard login. The built-in defaults are admin/admin, which are published
# in the docs and must be changed before the dashboard is reachable.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# -----------------------------------------------------------------------------
# RECOMMENDED
# -----------------------------------------------------------------------------

# Public base URL, used to build media links and the API docs examples. Set it
# when running behind a reverse proxy, otherwise generated URLs point at
# localhost and media will not load for clients outside the host.
WAHA_BASE_URL=https://wa.example.com

# Comma-separated proxy IPs. Without this the rate limiter keys on the proxy
# address instead of the real client, so one noisy client throttles everyone.
TRUSTED_PROXIES=

# NOWEB (Baileys, no browser) unless you specifically need Chrome parity.
WHATSAPP_DEFAULT_ENGINE=NOWEB

# info for production. debug is very verbose and switches logs to pretty output.
WAHA_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------

# Default is sqlite: session data, audit, templates and the sending policy
# ledger all live under the mounted data and .sessions directories.
# Only set the driver when you run Postgres, the way
# docker-compose.postgres.yml does for you.
# WAHA_DATABASE_DRIVER=postgres
# WAHA_DATABASE_URL=postgres://bunwa:change-me@postgres:5432/bunwa

# -----------------------------------------------------------------------------
# NOTE ON SESSION SETTINGS
# -----------------------------------------------------------------------------

# Not an environment variable, but the one setting that bites hardest in
# production: keep the message store enabled for every session
# (noweb.store.enabled true, full sync on for backfill). With it off, chat,
# message, contact and LID reads all fail with a store error, and the dashboard
# chat view and any workflow that reads history will break.
